# Copy to .env. Never commit .env.
# Skill text is sent to remote providers unless LLM_LOCAL_ONLY=true.

LLM_PROVIDER_ORDER=google,openrouter,lmstudio
LLM_FALLBACK_ENABLED=true
LLM_LOCAL_ONLY=false

# Google Gemini native API (google-genai). Discover IDs via: skillvm probe
# Official Gemma 4 IDs (https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api):
#   gemma-4-26b-a4b-it
#   gemma-4-31b-it
# Do not assume these are available on your key until probe lists them.
GEMINI_API_KEY=
GEMINI_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# https://openrouter.ai/google/gemma-4-26b-a4b-it
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Must match an ID the running LM Studio server reports (skillvm probe).
LMSTUDIO_MODEL=

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES_PER_PROVIDER=1
LLM_MAX_FALLBACK_ATTEMPTS=3
LLM_OVERALL_DEADLINE_SECONDS=120
LLM_TEMPERATURE=0

SKILLVM_DATA_DIR=.skillvm
SKILLVM_BIND=127.0.0.1
SKILLVM_PORT=8477
